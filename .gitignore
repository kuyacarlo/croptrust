# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.codex
chathistory.md

# production
/build
/.agents/

# large binaries / uploads
public/*.jpg
public/*.jpeg
public/*.png
public/*.gif
public/*.mp4
public/*.webm
*.zip
*.tar.gz
*.7z

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

/contracts/target/
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma cache
.prisma/
*.db-journal
agri-con-*-firebase-*.json

