{
  "info": {
    "name": "CropTrust API",
    "description": "End-to-end API tests for the CropTrust platform: Next.js route handlers (frontendUrl) and the Express backend (backendUrl). Set the 'CropTrust (Local)' environment before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Frontend (Next.js route handlers)",
      "item": [
        {
          "name": "GET /api/price",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('has numeric xlmUsd', () => pm.expect(j.xlmUsd).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{frontendUrl}}/api/price",
              "host": ["{{frontendUrl}}"],
              "path": ["api", "price"]
            }
          }
        },
        {
          "name": "GET /api/openeo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 500', () => pm.expect([200,500]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "pm.test('has ok flag', () => pm.expect(j).to.have.property('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{frontendUrl}}/api/openeo",
              "host": ["{{frontendUrl}}"],
              "path": ["api", "openeo"]
            }
          }
        },
        {
          "name": "POST /api/verification/run (preview)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with JSON ok flag', () => pm.expect(pm.response.json()).to.have.property('ok'));",
                  "// nftId 0 = preview mode: no on-chain attestation is prepared."
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nftId\": 0,\n  \"bbox\": { \"west\": 120.90, \"south\": 14.40, \"east\": 120.92, \"north\": 14.42 },\n  \"sampleGridSize\": 16,\n  \"minNdviBps\": 3500\n}"
            },
            "url": {
              "raw": "{{frontendUrl}}/api/verification/run",
              "host": ["{{frontendUrl}}"],
              "path": ["api", "verification", "run"]
            }
          }
        },
