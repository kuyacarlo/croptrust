    {
      "name": "Backend (Express)",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('ok is true', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendUrl}}/health",
              "host": ["{{backendUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "POST /api/profile (upsert farmer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns profile', () => pm.expect(pm.response.json()).to.have.property('profile'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address\": \"{{farmerAddress}}\",\n  \"fullName\": \"Test Farmer\",\n  \"farmName\": \"Sunrise Rice Farm\",\n  \"region\": \"Cavite\",\n  \"totalYieldKg\": 5000\n}"
            },
            "url": {
              "raw": "{{backendUrl}}/api/profile",
              "host": ["{{backendUrl}}"],
              "path": ["api", "profile"]
            }
          }
        },
        {
          "name": "GET /api/profile?address",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendUrl}}/api/profile?address={{farmerAddress}}",
              "host": ["{{backendUrl}}"],
              "path": ["api", "profile"],
              "query": [{ "key": "address", "value": "{{farmerAddress}}" }]
            }
          }
        },
        {
          "name": "POST /api/listings (upsert listing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.listing && j.listing.id) pm.environment.set('listingId', j.listing.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nftId\": {{nftId}},\n  \"cropType\": \"rice\",\n  \"quantityKg\": 5000,\n  \"priceUsdc\": 2500,\n  \"farmerId\": \"{{farmerAddress}}\",\n  \"parcelName\": \"Test Farm\",\n  \"region\": \"Cavite\",\n  \"buyable\": true,\n  \"ndviBps\": 6200,\n  \"minNdviBps\": 3500,\n  \"areaHa\": 1.25\n}"
            },
            "url": {
              "raw": "{{backendUrl}}/api/listings",
              "host": ["{{backendUrl}}"],
              "path": ["api", "listings"]
            }
          }
        },
        {
          "name": "GET /api/listings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{backendUrl}}/api/listings?buyable=true",
              "host": ["{{backendUrl}}"],
              "path": ["api", "listings"],
              "query": [{ "key": "buyable", "value": "true" }]
            }
          }
        },
